{
  "version": 2,
  "builds": [
    {
      "src": "custom-css/**",
      "use": "@vercel/static"
    },
    {
      "src": "custom-js/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/custom-css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/custom-js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}